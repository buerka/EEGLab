---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { papers } from '../data/papers';
import { research } from '../data/research';

const featuredPapers = papers.slice(0, 3);
---

<Layout title="金牛湖脑机实验室 · 南京信息工程大学">
  <Nav active="home" />

  <!-- ── RIGHT SECTION NAV ──────────────────────────────── -->
  <nav id="section-nav" aria-label="页面导航">
    <button class="sn-dot active" data-target="hero">
      <span class="sn-label">首页</span>
      <span class="sn-line"></span>
    </button>
    <button class="sn-dot" data-target="statement">
      <span class="sn-label">理念</span>
      <span class="sn-line"></span>
    </button>
    <button class="sn-dot" data-target="stats">
      <span class="sn-label">数据</span>
      <span class="sn-line"></span>
    </button>
    <button class="sn-dot" data-target="research">
      <span class="sn-label">研究</span>
      <span class="sn-line"></span>
    </button>
    <button class="sn-dot" data-target="team">
      <span class="sn-label">团队</span>
      <span class="sn-line"></span>
    </button>
    <button class="sn-dot" data-target="papers">
      <span class="sn-label">论文</span>
      <span class="sn-line"></span>
    </button>
    <button class="sn-dot" data-target="contact">
      <span class="sn-label">联系</span>
      <span class="sn-line"></span>
    </button>
  </nav>

  <!-- ── FULL-PAGE SCROLL CONTAINER ────────────────────── -->
  <div id="fp-container">

    <!-- 01 · HERO ─────────────────────────────────────── -->
    <section id="hero" class="fp-section fp-hero">
      <video class="hero-video" autoplay muted loop playsinline>
        <source src="/videos/promo.mp4" type="video/mp4" />
      </video>
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <p class="hero-eyebrow">Brain-Computer Interface Lab · NUIST</p>
        <h1 class="hero-title">让<em>思想</em><br/>驱动未来</h1>
        <div class="hero-actions">
          <a href="/research" class="btn btn-dark">探索研究方向</a>
          <a href="/achievements" class="btn btn-outline hero-btn-outline">查看科研成果</a>
        </div>
      </div>
    </section>

    <!-- 02 · SLOGAN ──────────────────────────────────── -->
    <section id="statement" class="fp-section fp-statement">
      <div class="container">
        <p class="statement-text">
          从<strong>脑电信号</strong>到运动控制，<br/>
          让<strong>思想</strong>驱动<span id="tw-word">未来</span><span class="tw-cursor"></span>
        </p>
        <p class="statement-en fade-up delay-1">From EEG Signal to Motion Control — Let Thought Drive the Future</p>
      </div>
    </section>

    <!-- 03 · STATS ───────────────────────────────────── -->
    <section id="stats" class="fp-section fp-stats">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-item fade-up">
            <span class="stat-num">60<sup>+</sup></span>
            <span class="stat-label">期刊论文</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item fade-up delay-1">
            <span class="stat-num">40<sup>+</sup></span>
            <span class="stat-label">授权专利</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item fade-up delay-2">
            <span class="stat-num">5</span>
            <span class="stat-label">核心研究方向</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item fade-up delay-3">
            <span class="stat-num">7</span>
            <span class="stat-label">代表性奖项</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 04 · RESEARCH ────────────────────────────────── -->
    <section id="research" class="fp-section fp-research">
      <div class="container">
        <div class="split-header">
          <div>
            <div class="section-label fade-up">Research Directions</div>
            <h2 class="section-title fade-up delay-1">五大研究方向</h2>
          </div>
          <p class="section-desc fade-up delay-2">围绕脑机接口核心技术，探索从信号采集到运动控制的完整链路。</p>
        </div>

        <div class="research-grid fade-up delay-3">
          {research.map(r => (
            <a href={`/research/${r.slug}`} class="r-card">
              <div class="r-card-header">
                <span class="r-num">{r.num}</span>
                <svg class="r-arrow" viewBox="0 0 20 20" fill="none">
                  <path d="M4 16L16 4M16 4H7M16 4V13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </div>
              <h3 class="r-title">{r.title}</h3>
              <p class="r-en">{r.titleEn}</p>
              <p class="r-desc">{r.desc}</p>
              <div class="r-tags">
                {r.tags.slice(0, 3).map(tag => <span class="r-tag">{tag}</span>)}
              </div>
            </a>
          ))}
        </div>

        <div class="section-cta fade-up delay-4">
          <a href="/research" class="arrow-link">
            查看全部研究方向
            <span class="arrow-icon">
              <svg class="arrow-out" viewBox="0 0 18 18"><path d="M2 16L16 2M16 2H6M16 2V12"/></svg>
              <svg class="arrow-in" viewBox="0 0 18 18"><path d="M2 16L16 2M16 2H6M16 2V12"/></svg>
            </span>
          </a>
        </div>
      </div>
    </section>

    <!-- 05 · TEAM ────────────────────────────────────── -->
    <section id="team" class="fp-section fp-team">
      <div class="container">
        <div class="split-header">
          <div>
            <div class="section-label fade-up">Team</div>
            <h2 class="section-title fade-up delay-1">核心团队</h2>
          </div>
          <p class="section-desc fade-up delay-2">汇聚神经工程、信号处理、机器人控制等多学科背景的研究人员，共同推进脑机接口前沿探索。</p>
        </div>

        <div class="mentor-block fade-up delay-2">
          <div class="mentor-avatar">颖</div>
          <div class="mentor-right">
            <span class="mentor-role">副教授 · 硕士生导师</span>
            <h3 class="mentor-name">严颖</h3>
            <p class="mentor-bio">博士毕业于美国康涅狄格大学，研究方向涵盖脑电信号分析、模式识别、机器学习与深度学习。主持多项国家自然科学基金及省部级科研项目，在 IEEE 系列期刊发表论文 60 余篇。</p>
            <div class="mentor-tags">
              <span>EEG 信号分析</span>
              <span>模式识别</span>
              <span>深度学习</span>
            </div>
          </div>
        </div>

        <div class="section-cta fade-up delay-3">
          <a href="/team" class="arrow-link">
            查看完整团队
            <span class="arrow-icon">
              <svg class="arrow-out" viewBox="0 0 18 18"><path d="M2 16L16 2M16 2H6M16 2V12"/></svg>
              <svg class="arrow-in" viewBox="0 0 18 18"><path d="M2 16L16 2M16 2H6M16 2V12"/></svg>
            </span>
          </a>
        </div>
      </div>
    </section>

    <!-- 06 · PAPERS ──────────────────────────────────── -->
    <section id="papers" class="fp-section fp-papers">
      <div class="container">
        <div class="split-header">
          <div>
            <div class="section-label fade-up">Publications</div>
            <h2 class="section-title fade-up delay-1">代表论文</h2>
          </div>
          <p class="section-desc fade-up delay-2">团队在脑机接口、EEG 信号分析等领域发表期刊论文 60 余篇。</p>
        </div>

        <div class="paper-list fade-up delay-2">
          {featuredPapers.map(p => (
            <a href="/achievements" class="paper-row">
              <span class="pr-year">{p.year}</span>
              <div class="pr-body">
                <p class="pr-title">{p.title}</p>
                <p class="pr-journal">{p.journal}{p.impactFactor ? ` · IF ${p.impactFactor}` : ''}</p>
              </div>
              <svg class="pr-icon" viewBox="0 0 20 20" fill="none">
                <path d="M3 10h14M12 5l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          ))}
        </div>

        <div class="section-cta fade-up delay-3">
          <a href="/achievements" class="arrow-link">
            查看全部科研成果
            <span class="arrow-icon">
              <svg class="arrow-out" viewBox="0 0 18 18"><path d="M2 16L16 2M16 2H6M16 2V12"/></svg>
              <svg class="arrow-in" viewBox="0 0 18 18"><path d="M2 16L16 2M16 2H6M16 2V12"/></svg>
            </span>
          </a>
        </div>
      </div>
    </section>

    <!-- 07 · CONTACT ─────────────────────────────────── -->
    <section id="contact" class="fp-section fp-contact">
      <div class="container contact-wrap">
        <div class="contact-inner">
          <div class="contact-left fade-up">
            <div class="section-label">Contact</div>
            <h2 class="section-title">共筑脑机未来</h2>
            <p class="section-desc">汇聚跨学科智慧，诚邀各界英才共同探索脑机接口前沿</p>
            <a href="mailto:ying.yan@nuist.edu.cn" class="btn btn-dark btn-sm" style="margin-top:32px">
              发送邮件
            </a>
          </div>
          <div class="contact-right fade-up delay-2">
            <div class="cd-row">
              <span class="cd-label">邮箱</span>
              <span class="cd-value">ying.yan@nuist.edu.cn</span>
            </div>
            <div class="cd-row">
              <span class="cd-label">电话</span>
              <span class="cd-value">+86 152-0517-6357</span>
            </div>
            <div class="cd-row">
              <span class="cd-label">地址</span>
              <span class="cd-value">南京信息工程大学 · 金牛湖产教融合园区</span>
            </div>
          </div>
        </div>
      </div>
      <Footer />
    </section>

  </div>
</Layout>

<!-- ── SCRIPTS ──────────────────────────────────────────── -->
<script>
  /* ── 0. Setup: make html/body allow the custom scroller ── */
  document.documentElement.style.height = '100%';
  document.documentElement.style.overflow = 'hidden';
  document.body.style.height = '100%';
  document.body.style.overflow = 'hidden';

  const container = document.getElementById('fp-container')!;
  const fpSections = [...document.querySelectorAll<HTMLElement>('.fp-section')];
  const snDots = [...document.querySelectorAll<HTMLButtonElement>('.sn-dot')];
  const badge = document.getElementById('nav-section-badge')!;

  /* Section metadata */
  const sectionMeta: Record<string, { label: string; navHref: string | null }> = {
    hero:      { label: '首页',   navHref: null },
    statement: { label: '理念',   navHref: null },
    stats:     { label: '数据',   navHref: null },
    research:  { label: '研究方向', navHref: '/research' },
    team:      { label: '团队成员', navHref: '/team' },
    papers:    { label: '科研成果', navHref: '/achievements' },
    contact:   { label: '联系我们', navHref: '/contact' },
  };

  let currentIdx = 0;

  /* ── 1. Dash nav: click to jump ── */
  snDots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      container.scrollTo({ top: fpSections[i].offsetTop, behavior: 'smooth' });
    });
  });

  /* ── 2. Update active state in dash nav + navbar ── */
  function setActive(idx: number) {
    if (idx === currentIdx) return;
    currentIdx = idx;

    // Dash nav
    snDots.forEach((d, i) => d.classList.toggle('active', i === idx));

    // Navbar links
    const sectionId = fpSections[idx]?.id ?? '';
    const meta = sectionMeta[sectionId];
    document.querySelectorAll('.nav-links a').forEach(a => a.classList.remove('active'));
    if (meta?.navHref) {
      const link = document.querySelector<HTMLAnchorElement>(
        `.nav-links a[href="${meta.navHref}"]`
      );
      link?.classList.add('active');
    }

    // Badge
    if (meta) {
      badge.textContent = meta.label;
      badge.classList.add('visible');
    }
  }

  /* ── 3. Track sections via IntersectionObserver ── */
  const sectionObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
        const idx = fpSections.indexOf(entry.target as HTMLElement);
        if (idx !== -1) setActive(idx);
      }
    });
  }, { root: container, threshold: 0.5 });

  fpSections.forEach(s => sectionObserver.observe(s));

  /* ── 4. Fade-up animations (root = scroll container) ── */
  const fadeObserver = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        fadeObserver.unobserve(e.target);
      }
    });
  }, { root: container, threshold: 0.08, rootMargin: '0px 0px -20px 0px' });

  document.querySelectorAll('.fade-up').forEach(el => fadeObserver.observe(el));

  /* ── 5. Wheel → scroll one section at a time ── */
  let isScrolling = false;
  container.addEventListener('wheel', (e: WheelEvent) => {
    e.preventDefault();
    if (isScrolling) return;
    isScrolling = true;

    const dir = e.deltaY > 0 ? 1 : -1;
    const next = Math.max(0, Math.min(fpSections.length - 1, currentIdx + dir));
    container.scrollTo({ top: fpSections[next].offsetTop, behavior: 'smooth' });

    // Unlock after animation (~700ms)
    setTimeout(() => { isScrolling = false; }, 700);
  }, { passive: false });

  /* ── 6. Touch swipe support ── */
  let touchStartY = 0;
  container.addEventListener('touchstart', (e: TouchEvent) => {
    touchStartY = e.touches[0].clientY;
  }, { passive: true });
  container.addEventListener('touchend', (e: TouchEvent) => {
    if (isScrolling) return;
    const dy = touchStartY - e.changedTouches[0].clientY;
    if (Math.abs(dy) < 30) return;
    isScrolling = true;
    const dir = dy > 0 ? 1 : -1;
    const next = Math.max(0, Math.min(fpSections.length - 1, currentIdx + dir));
    container.scrollTo({ top: fpSections[next].offsetTop, behavior: 'smooth' });
    setTimeout(() => { isScrolling = false; }, 700);
  }, { passive: true });

  /* ── 7. Keyboard navigation ── */
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (isScrolling) return;
    if (e.key === 'ArrowDown' || e.key === 'PageDown') {
      e.preventDefault();
      isScrolling = true;
      const next = Math.min(fpSections.length - 1, currentIdx + 1);
      container.scrollTo({ top: fpSections[next].offsetTop, behavior: 'smooth' });
      setTimeout(() => { isScrolling = false; }, 700);
    }
    if (e.key === 'ArrowUp' || e.key === 'PageUp') {
      e.preventDefault();
      isScrolling = true;
      const next = Math.max(0, currentIdx - 1);
      container.scrollTo({ top: fpSections[next].offsetTop, behavior: 'smooth' });
      setTimeout(() => { isScrolling = false; }, 700);
    }
  });

  /* ── 8. Initial badge ── */
  setActive(0);

  /* ── 9. Typewriter on statement section ── */
  {
    const words = ['未来', '机器', '世界', '生命'];
    let wordIdx = 0;
    let charIdx = words[0].length; // start fully typed
    let isDeleting = false;
    let twStarted = false;
    const twWordEl = document.getElementById('tw-word')!;

    function typeStep() {
      const target = words[wordIdx];
      if (isDeleting) {
        charIdx--;
        twWordEl.textContent = target.slice(0, charIdx);
        if (charIdx === 0) {
          isDeleting = false;
          wordIdx = (wordIdx + 1) % words.length;
          setTimeout(typeStep, 380);
          return;
        }
        setTimeout(typeStep, 90);
      } else {
        charIdx++;
        twWordEl.textContent = words[wordIdx].slice(0, charIdx);
        if (charIdx === words[wordIdx].length) {
          isDeleting = true;
          setTimeout(typeStep, 2400);
          return;
        }
        setTimeout(typeStep, 140);
      }
    }

    const stmtSection = document.getElementById('statement')!;
    new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !twStarted) {
          twStarted = true;
          setTimeout(() => { isDeleting = true; typeStep(); }, 1200);
        }
      });
    }, { root: container, threshold: 0.5 }).observe(stmtSection);
  }
</script>

<style>
  /* ── FULLPAGE SCROLL CONTAINER ──────────────────────── */
  #fp-container {
    position: fixed;
    inset: 0;
    overflow-y: scroll;
    scroll-snap-type: y mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  #fp-container::-webkit-scrollbar { display: none; }

  /* ── SECTION BASE ────────────────────────────────────── */
  .fp-section {
    height: 100vh;
    scroll-snap-align: start;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 68px; /* clear fixed nav */
    box-sizing: border-box;
  }

  /* ── RIGHT SIDE SECTION NAV ──────────────────────────── */
  #section-nav {
    position: fixed;
    right: 32px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 200;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-end;
  }
  .sn-dot {
    display: flex;
    align-items: center;
    gap: 10px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 3px 0;
  }
  .sn-label {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--text-3);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(6px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .sn-line {
    display: block;
    height: 1.5px;
    width: 12px;
    background: rgba(0,0,0,0.18);
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                background 0.3s ease;
    flex-shrink: 0;
  }
  .sn-dot:hover .sn-label { opacity: 1; transform: none; }
  .sn-dot:hover .sn-line { background: rgba(0,0,0,0.35); width: 16px; }
  .sn-dot.active .sn-label { opacity: 1; transform: none; color: var(--accent); }
  .sn-dot.active .sn-line { width: 21px; background: var(--accent); }

  @media (max-width: 768px) { #section-nav { display: none; } }

  /* ═══════════════════════════════════════════════════
     01 HERO
  ═══════════════════════════════════════════════════ */
  .fp-hero {
    justify-content: flex-end;
    align-items: stretch;
    background: #000;
    border-bottom: none;
    padding-top: 0;
  }
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.20); 
    /* 视频太暗或太亮，可以调整 hero-overlay 的 rgba(0,0,0,0.52) 这个透明度 */
    z-index: 1;
  }
  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 0 6vw clamp(48px, 7vw, 88px) 6vw;
  }
  .hero-eyebrow {
    font-size: 11px;
    font-family: var(--font-mono);
    letter-spacing: 3px;
    color: rgba(255, 255, 255, 0.45);
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .hero-title {
    font-size: clamp(38px, 5.5vw, 72px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.05em;
    color: #fff;
    margin-bottom: 40px;
  }
  .hero-title em {
    font-style: normal;
    color: var(--accent);
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .hero-btn-outline {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.3);
  }
  .hero-btn-outline:hover {
    background: rgba(255, 255, 255, 0.1);
    opacity: 1;
  }

  /* ═══════════════════════════════════════════════════
     02 SLOGAN
  ═══════════════════════════════════════════════════ */
  .fp-statement {
    background: var(--bg-surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    justify-content: center;
    text-align: center;
  }
  .statement-text {
    font-size: clamp(26px, 4vw, 52px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.3;
    color: var(--text);
    max-width: 720px;
    margin: 0 auto 20px;
  }
  .statement-text strong {
    color: var(--text);
    position: relative;
  }
  .statement-text strong::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0; right: 0;
    height: 2px;
    background: var(--accent);
    border-radius: 2px;
  }
  .statement-en {
    font-size: 12px;
    font-family: var(--font-mono);
    color: var(--text-3);
    letter-spacing: 2px;
  }
  .tw-cursor {
    display: inline-block;
    width: 3px;
    height: 0.78em;
    background: var(--accent);
    margin-left: 3px;
    vertical-align: -0.04em;
    border-radius: 1.5px;
    animation: tw-blink 1s step-end infinite;
  }
  @keyframes tw-blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }

  /* ═══════════════════════════════════════════════════
     03 STATS
  ═══════════════════════════════════════════════════ */
  .fp-stats {
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .stats-grid {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: nowrap;
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 0 clamp(28px, 5vw, 72px);
  }
  .stat-divider {
    width: 1px;
    height: 64px;
    background: var(--border-md);
    flex-shrink: 0;
