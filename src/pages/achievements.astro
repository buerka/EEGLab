---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PaperFilter from '../components/PaperFilter.astro';
import GalleryFilter from '../components/GalleryFilter.astro';
import type { Paper } from '../components/PaperFilter';
import awardsData from '../data/awards.toml';
import papersData from '../data/papers.toml';
import galleryData from '../data/gallery.toml';

type Award = { year: number; name: string; description: string; image?: string; images?: string[] };
const awards = ((awardsData as any).awards as Award[]).map((award) => ({
  ...award,
  images: award.images ?? (award.image ? [award.image] : []),
}));
const papers = (papersData as any).papers as Paper[];
const filterTags = (papersData as any).filter_tags as string[];
const galleryGrid = (galleryData as any).grid as { src: string; label: string; tag: string }[];
---

<Layout
  title="科研成果 · 金牛湖脑机实验室"
  description="严颖副教授团队在脑机接口、EEG信号分析、模式识别等领域的学术成果汇总"
>
  <Nav active="achievements" />

  <!-- ── PAGE HEADER ──────────────────────────────────── -->
  <div class="page-header">
    <div class="container">
      <a href="/" class="back-link">
        <svg viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        返回主页
      </a>
      <div class="ph-inner">
        <div>
          <div class="section-label">ACHIEVEMENTS</div>
          <h1 class="ph-title">科研成果</h1>
          <p class="ph-sub">严颖副教授团队在脑机接口、EEG 信号分析、模式识别等领域的学术成果汇总</p>
        </div>
        <div class="stats-row">
          <div class="stat-item">
            <div class="stat-num">78+</div>
            <div class="stat-label">期刊论文</div>
          </div>
          <div class="stat-item">
            <div class="stat-num">16+</div>
            <div class="stat-label">授权专利</div>
          </div>
          <div class="stat-item">
            <div class="stat-num">{awards.length}</div>
            <div class="stat-label">代表奖项</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── BODY ────────────────────────────────────────── -->
  <div class="ach-body">

    <!-- Sidebar -->
    <aside class="ach-sidebar" id="ach-sidebar">
      <div class="sidebar-label">CONTENTS</div>
      <ul class="sidebar-nav" id="sidebar-nav">
        <li>
          <a href="#papers" class="active">
            <svg viewBox="0 0 16 16" fill="none"><path d="M9 2H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V6L9 2zm0 0v4h4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            期刊与会议论文
            <span class="nav-count">{papers.length}</span>
          </a>
        </li>
        <li>
          <a href="#awards">
            <svg viewBox="0 0 16 16" fill="none"><circle cx="8" cy="6" r="4" stroke="currentColor" stroke-width="1.3"/><path d="M5.5 9.5L4.5 14l3.5-2 3.5 2-1-4.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            荣誉奖项
            <span class="nav-count">{awards.length}</span>
          </a>
        </li>
        <li>
          <a href="#gallery">
            <svg viewBox="0 0 16 16" fill="none"><rect x="2" y="2" width="12" height="12" rx="1.5" stroke="currentColor" stroke-width="1.3"/><circle cx="5.5" cy="5.5" r="1" fill="currentColor" opacity="0.6"/><path d="M2 11l4-4 3 3 2-2 3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            成果展示
            <span class="nav-count">{galleryGrid.length}</span>
          </a>
        </li>
      </ul>
    </aside>

    <!-- Main content -->
    <main class="ach-main">

      <!-- Papers -->
      <section id="papers" class="ach-section">
        <div class="section-header">
          <h2 class="section-heading">期刊与会议论文</h2>
        </div>
        <PaperFilter papers={papers} filterTags={filterTags} />
      </section>

      <!-- Awards -->
      <section id="awards" class="ach-section">
        <div class="section-header">
          <h2 class="section-heading">荣誉奖项</h2>
        </div>
        <div class="award-timeline">
          {awards.map((award, i) => (
            <div class="award-row">
              <div class="award-left">
                <div class="award-dot"></div>
                {i < awards.length - 1 && <div class="award-line"></div>}
                <span class="award-year">{award.year}</span>
              </div>
              <div class="award-body">
                <div class="award-name">{award.name}</div>
                <div class="award-desc">{award.description}</div>
                {award.images.length > 0 && (
                  <div class="award-images">
                    {award.images.map((image) => (
                      <div class="award-img">
                        <img src={image} alt={award.name} loading="lazy" />
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Gallery -->
      <section id="gallery" class="ach-section">
        <div class="section-header">
          <h2 class="section-heading">成果展示</h2>
          <span class="section-note">按类别筛选</span>
        </div>
        <GalleryFilter items={galleryGrid} />
      </section>

    </main>
  </div>

  <Footer />
</Layout>

<script>
  const sections = document.querySelectorAll('.ach-section');
  const navLinks = document.querySelectorAll('#sidebar-nav a');
  const io = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        navLinks.forEach(a => a.classList.remove('active'));
        const link = document.querySelector(`#sidebar-nav a[href="#${entry.target.id}"]`);
        link?.classList.add('active');
      }
    });
  }, { rootMargin: '-30% 0px -55% 0px' });
  sections.forEach(s => io.observe(s));
</script>

<style>
  /* ── PAGE HEADER ────────────────────────────────────── */
  .page-header {
    padding: 140px 0 72px;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border);
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--text-3);
    text-decoration: none;
    margin-bottom: 32px;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--text-2); }
  .back-link svg { width: 16px; height: 16px; }

  .ph-inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 48px;
    flex-wrap: wrap;
  }
  .ph-title {
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 16px;
  }
  .ph-sub {
    font-size: 16px;
    color: var(--text-2);
    max-width: 480px;
    line-height: 1.7;
  }
  .stats-row {
    display: flex;
    gap: 48px;
    flex-shrink: 0;
  }
  .stat-item { text-align: right; }
  .stat-num {
    font-size: 48px;
    font-weight: 700;
    color: var(--text);
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .stat-label {
    font-size: 11px;
    color: var(--text-3);
    font-family: var(--font-mono);
    letter-spacing: 2px;
    margin-top: 6px;
  }

  /* ── BODY LAYOUT ────────────────────────────────────── */
  .ach-body {
    max-width: 1400px;
    margin: 0 auto;
    padding: 80px 6vw;
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 72px;
    align-items: start;
  }

  /* ── SIDEBAR ────────────────────────────────────────── */
  .ach-sidebar {
    position: sticky;
    top: 88px;
  }
  .sidebar-label {
    font-size: 10px;
    font-family: var(--font-mono);
    letter-spacing: 4px;
    color: var(--text-3);
    margin-bottom: 16px;
  }
  .sidebar-nav {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .sidebar-nav a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    font-size: 14px;
    color: var(--text-2);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background 0.15s, color 0.15s;
    font-weight: 400;
  }
  .sidebar-nav a svg { width: 14px; height: 14px; flex-shrink: 0; }
  .sidebar-nav a:hover,
  .sidebar-nav a.active {
    background: var(--bg-surface);
    color: var(--text);
  }
  .sidebar-nav a.active {
    border-left: 2px solid var(--accent);
    padding-left: 12px;
  }
  .nav-count {
    margin-left: auto;
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--text-3);
  }

  /* ── SECTIONS ───────────────────────────────────────── */
  .ach-section {
    margin-bottom: 100px;
    scroll-margin-top: 88px;
  }
  .section-header {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 40px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
  }
  .section-heading {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .section-note {
    font-size: 12px;
    color: var(--text-3);
    font-family: var(--font-mono);
  }

  /* ── AWARDS ─────────────────────────────────────────── */
  .award-timeline { padding-left: 0; }
  .award-row {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 20px;
    position: relative;
    padding-bottom: 32px;
    align-items: start;
  }
  .award-row:last-child { padding-bottom: 0; }
  .award-left {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .award-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
    margin-top: 6px;
    opacity: 0.6;
  }
  .award-line {
    width: 1px;
    flex: 1;
    background: linear-gradient(to bottom, rgba(0,87,255,0.15), transparent);
    margin-top: 6px;
    min-height: 20px;
  }
  .award-year {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--text-3);
    letter-spacing: 1px;
    margin-top: 6px;
    font-variant-numeric: tabular-nums;
  }
  .award-body { padding-top: 2px; }
  .award-images {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: flex-start;
  }
  .award-img {
    width: 220px;
    max-width: 100%;
    flex: 0 1 220px;
  }
  .award-img img {
    width: 100%;
    border-radius: 8px;
    border: 1px solid var(--border);
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .award-img img:hover {
    transform: scale(1.04);
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
  }
  .award-name {
    font-size: 17px;
    font-weight: 600;
    margin-bottom: 8px;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }
  .award-desc {
    font-size: 14px;
    color: var(--text-2);
    line-height: 1.7;
  }

  /* ── RESPONSIVE ─────────────────────────────────────── */
  @media (max-width: 900px) {
    .ach-body { grid-template-columns: 1fr; gap: 40px; padding: 48px 6vw; }
    .ach-sidebar { position: static; }
    .sidebar-nav { flex-direction: row; flex-wrap: wrap; }
    .sidebar-nav a { border-left: none !important; padding-left: 14px !important; }
    .sidebar-nav a.active { background: var(--bg-surface); }
    .nav-count { display: none; }
    .sidebar-label { display: none; }
    .ph-inner { flex-direction: column; align-items: flex-start; gap: 32px; }
    .stats-row { gap: 32px; }
    .stat-num { font-size: 36px; }
  }
</style>
