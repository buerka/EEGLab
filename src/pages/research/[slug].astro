---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { research } from '../../data/research';
import type { Paper } from '../../components/PaperFilter';
import papersData from '../../data/papers.toml';
const papers = (papersData as any).papers as Paper[];

export function getStaticPaths() {
  return research.map(r => ({ params: { slug: r.slug }, props: { item: r } }));
}

const { item } = Astro.props;

const relatedPapers = papers.filter(p =>
  p.tags.some(t => item.tags.some(rt => t.includes(rt.slice(0, 3))))
).slice(0, 3);

const allResearch = research;
const currentIdx = allResearch.findIndex(r => r.slug === item.slug);
const prev = allResearch[currentIdx - 1];
const next = allResearch[currentIdx + 1];
---

<Layout
  title={`${item.title} · 金牛湖脑机实验室`}
  description={item.desc}
>
  <Nav active="home" />

  <div class="page-wrap">

    <!-- Sidebar -->
    <aside class="sidebar">
      <a href="/" class="back-link">
        <svg viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        返回主页
      </a>

      <nav class="dir-nav">
        <div class="dir-nav-label">研究方向</div>
        {allResearch.map(r => (
          <a
            href={`/research/${r.slug}`}
            class:list={['dir-nav-item', { active: r.slug === item.slug }]}
          >
            <span class="dir-num">{r.num}</span>
            {r.title}
          </a>
        ))}
      </nav>
    </aside>

    <!-- Main -->
    <main class="main">
      <div class="page-meta">
        <span class="meta-num">{item.num}</span>
        <span class="meta-en">{item.titleEn}</span>
      </div>

      <h1 class="page-title">{item.title}</h1>
      <p class="page-lead">{item.desc}</p>

      <div class="divider"></div>

      <section class="overview">
        <h2 class="sec-title">研究概述</h2>
        <p class="sec-body">{item.overview}</p>
      </section>

      <section class="methods">
        <h2 class="sec-title">研究方法</h2>
        <div class="method-list">
          {item.methods.map((m, i) => (
            <div class="method-item">
              <div class="method-num">{String(i + 1).padStart(2, '0')}</div>
              <div class="method-body">
                <div class="method-title">{m.title}</div>
                <p class="method-desc">{m.body}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <div class="tag-row">
        {item.tags.map(t => <span class="tag">{t}</span>)}
      </div>

      {relatedPapers.length > 0 && (
        <section class="related">
          <h2 class="sec-title">相关论文</h2>
          <div class="paper-list">
            {relatedPapers.map(p => (
              <a href="/achievements" class="paper-item">
                <div class="pi-year">{p.year}</div>
                <div class="pi-body">
                  <div class="pi-title">{p.title}</div>
                  <div class="pi-journal">{p.journal}</div>
                </div>
                <svg class="pi-arrow" viewBox="0 0 18 18" fill="none">
                  <path d="M2 16L16 2M16 2H6M16 2V12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            ))}
          </div>
          <a href="/achievements" class="arrow-link" style="font-size:15px">
            查看全部成果
            <span class="arrow-icon">
              <svg class="arrow-out" viewBox="0 0 18 18"><path d="M2 16L16 2M16 2H6M16 2V12"/></svg>
              <svg class="arrow-in" viewBox="0 0 18 18"><path d="M2 16L16 2M16 2H6M16 2V12"/></svg>
            </span>
          </a>
        </section>
      )}

      <!-- Prev / Next -->
      <div class="pager">
        {prev ? (
          <a href={`/research/${prev.slug}`} class="pager-item prev">
            <div class="pager-label">上一个</div>
            <div class="pager-title">
              <svg viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {prev.title}
            </div>
          </a>
        ) : <div />}
        {next ? (
          <a href={`/research/${next.slug}`} class="pager-item next">
            <div class="pager-label">下一个</div>
            <div class="pager-title">
              {next.title}
              <svg viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
          </a>
        ) : <div />}
      </div>
    </main>

  </div>

  <Footer />
</Layout>

<style>
  .page-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 120px 6vw 80px;
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 72px;
    align-items: start;
  }

  /* ── SIDEBAR ─────────────────────────────────────────── */
  .sidebar { position: sticky; top: 88px; }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--text-3);
    text-decoration: none;
    margin-bottom: 36px;
    transition: color 0.15s;
  }
  .back-link:hover { color: var(--text-2); }
  .back-link svg { width: 16px; height: 16px; }

  .dir-nav-label {
    font-size: 10px;
    font-family: var(--font-mono);
    letter-spacing: 4px;
    color: var(--text-3);
    margin-bottom: 12px;
  }
  .dir-nav { display: flex; flex-direction: column; gap: 1px; }
  .dir-nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    font-size: 14px;
    color: var(--text-2);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background 0.15s, color 0.15s;
    border-left: 2px solid transparent;
    font-weight: 400;
  }
  .dir-nav-item:hover { color: var(--text); background: rgba(0,0,0,0.04); }
  .dir-nav-item.active {
    color: var(--text);
    border-left-color: var(--accent);
    background: var(--accent-dim);
  }
  .dir-num {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-3);
    min-width: 20px;
    font-variant-numeric: tabular-nums;
  }

  /* ── MAIN ───────────────────────────────────────────── */
  .page-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }
  .meta-num {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }
  .meta-en {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-3);
    letter-spacing: 0.5px;
  }

  .page-title {
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 16px;
  }
  .page-lead {
    font-size: 17px;
    color: var(--text-2);
    line-height: 1.7;
    max-width: 580px;
  }

  .divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 56px 0;
  }

  .sec-title {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--text-3);
    font-family: var(--font-mono);
    margin-bottom: 28px;
  }
  .sec-body {
    font-size: 16px;
    color: var(--text-2);
    line-height: 1.9;
    max-width: 640px;
    margin-bottom: 56px;
  }

  /* methods */
  .method-list { display: flex; flex-direction: column; gap: 0; margin-bottom: 56px; }
  .method-item {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 24px;
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
  }
  .method-item:first-child { border-top: 1px solid var(--border); }
  .method-num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-3);
    padding-top: 3px;
    font-variant-numeric: tabular-nums;
  }
  .method-title { font-size: 16px; font-weight: 600; margin-bottom: 10px; letter-spacing: -0.01em; }
  .method-desc { font-size: 15px; color: var(--text-2); line-height: 1.8; }

  /* tags */
  .tag-row { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 64px; }
  .tag {
    font-size: 11px;
    font-family: var(--font-mono);
    padding: 4px 12px;
    border-radius: 100px;
    border: 1px solid var(--border);
    color: var(--text-3);
    letter-spacing: 0.5px;
  }

  /* related papers */
  .related { margin-bottom: 64px; }
  .paper-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 20px;
  }
  .paper-item {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 18px 22px;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s;
  }
  .paper-item:last-child { border-bottom: none; }
  .paper-item:hover { background: var(--bg-surface); }
  .paper-item:hover .pi-arrow { opacity: 1; transform: translate(4px, -4px); }

  .pi-year { font-family: var(--font-mono); font-size: 12px; color: var(--text-3); min-width: 40px; font-variant-numeric: tabular-nums; }
  .pi-body { flex: 1; min-width: 0; }
  .pi-title { font-size: 14px; font-weight: 500; line-height: 1.5; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 4px; }
  .pi-journal { font-size: 11px; font-family: var(--font-mono); color: var(--text-3); }
  .pi-arrow {
    width: 16px; height: 16px;
    color: var(--text-3);
    flex-shrink: 0;
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  /* pager */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    border-top: 1px solid var(--border);
    padding-top: 40px;
    margin-top: 40px;
  }
  .pager-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, background 0.2s;
  }
  .pager-item:hover { border-color: var(--border-md); background: var(--bg-surface); }
  .pager-item.next { text-align: right; }
  .pager-label { font-size: 11px; font-family: var(--font-mono); color: var(--text-3); letter-spacing: 2px; }
  .pager-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
  }
  .pager-item.next .pager-title { justify-content: flex-end; }
  .pager-title svg { width: 14px; height: 14px; flex-shrink: 0; }

  /* responsive */
  @media (max-width: 768px) {
    .page-wrap { grid-template-columns: 1fr; gap: 40px; padding-top: 100px; }
    .sidebar { position: static; }
    .dir-nav { flex-direction: row; flex-wrap: wrap; }
    .dir-nav-item { border-left: none; border-bottom: 2px solid transparent; }
    .dir-nav-item.active { border-bottom-color: var(--accent); background: none; }
    .pager { grid-template-columns: 1fr; }
  }
</style>
