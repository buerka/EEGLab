---
interface Props {
  active?: string;
}
const { active } = Astro.props;
const path = Astro.url.pathname;
const isResearch    = path.startsWith('/research');
const isTeam        = path === '/team';
const isAchievements = path === '/achievements' || active === 'achievements';
const isContact     = path === '/contact';
---

<nav id="navbar">
  <div class="nav-left">
    <a href="/" class="nav-brand" aria-label="金牛湖脑机实验室">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" class="nav-logo-svg">
        <rect x="1" y="10" width="20" height="1.4" rx="0.7" fill="currentColor" opacity="0.3"/>
        <path d="M1 10 Q4 4 8 10 Q11 16 14 10 Q18 4 21 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/>
      </svg>
      <span class="nav-brand-text">金牛湖脑机</span>
    </a>
    <span id="nav-section-badge" class="nav-section-badge" aria-live="polite"></span>
    <div class="nav-unis">
      <a href="https://www.nuist.edu.cn" target="_blank" rel="noopener noreferrer">
        <img src="/images/nuist-logo.png" alt="南京信息工程大学" class="nav-uni-logo nuist" />
      </a>
      <a href="https://www.ahjzu.edu.cn" target="_blank" rel="noopener noreferrer">
        <img src="/images/ahjzu-logo.png" alt="安徽建筑大学" class="nav-uni-logo ahjzu" />
      </a>
    </div>
  </div>

  <div class="nav-right">
    <ul class="nav-links" id="nav-links">
      <li><a href="/research" data-section="research" class:list={[{ active: isResearch }]}>研究方向</a></li>
      <li><a href="/team" data-section="team" class:list={[{ active: isTeam }]}>团队成员</a></li>
      <li><a href="/achievements" data-section="papers" class:list={[{ active: isAchievements }]}>科研成果</a></li>
      <li><a href="/contact" data-section="contact" class="nav-cta" class:list={[{ active: isContact }]}>联系我们</a></li>
    </ul>

      <button class="nav-toggle" id="nav-toggle" aria-label="菜单">
      <span></span><span></span>
    </button>
  </div>
</nav>

<script>
  const navbar = document.getElementById('navbar')!;
  window.addEventListener('scroll', () => {
    navbar.classList.toggle('scrolled', window.scrollY > 40);
  }, { passive: true });

  // Also listen on #fp-container if it exists (fullpage scroll)
  document.addEventListener('DOMContentLoaded', () => {
    const fp = document.getElementById('fp-container');
    if (fp) {
      fp.addEventListener('scroll', () => {
        navbar.classList.toggle('scrolled', fp.scrollTop > 40);
      }, { passive: true });
    }
  });

  document.getElementById('nav-toggle')!.addEventListener('click', () => {
    document.getElementById('nav-links')!.classList.toggle('open');
    document.getElementById('nav-toggle')!.classList.toggle('open');
  });
  document.querySelectorAll('#nav-links a').forEach(a => {
    a.addEventListener('click', () => {
      document.getElementById('nav-links')!.classList.remove('open');
      document.getElementById('nav-toggle')!.classList.remove('open');
    });
  });
</script>

<style>
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 6vw;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(0,0,0,0.06);
    transition: box-shadow 0.3s ease;
  }
  nav.scrolled {
    box-shadow: 0 1px 24px rgba(0,0,0,0.07);
  }

  .nav-left {
    display: flex;
    align-items: center;
    gap: 0;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text);
  }
  .nav-logo-svg {
    color: var(--text);
    flex-shrink: 0;
  }
  .nav-brand-text {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .nav-section-badge {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--text-3);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-left: 16px;
    padding-left: 16px;
    border-left: 1px solid var(--border-md);
    opacity: 0;
    transform: translateY(-3px);
    transition: opacity 0.35s ease, transform 0.35s ease;
    pointer-events: none;
  }
  .nav-section-badge.visible {
    opacity: 1;
    transform: none;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2px;
    list-style: none;
  }

  .nav-unis {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: 10px;
  }
  .nav-unis::before {
    content: '';
    width: 1px;
    height: 14px;
    background: var(--border-md);
    flex-shrink: 0;
  }
  .nav-uni-logo {
    width: auto;
    object-fit: contain;
    opacity: 0.7;
    transition: opacity 0.2s;
  }
  .nav-uni-logo:hover { opacity: 1; }
  .nav-uni-logo.nuist { height: 31px; }
  .nav-uni-logo.ahjzu { height: 24px; }
  .nav-links a {
    display: block;
    padding: 7px 14px;
    font-size: 14px;
    color: var(--text-2);
    text-decoration: none;
    border-radius: var(--radius-pill);
    transition: color 0.2s, background 0.2s;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .nav-links a:hover {
    color: var(--text);
    background: rgba(0,0,0,0.05);
  }
  .nav-links a.active {
    color: var(--text);
    background: rgba(0,0,0,0.05);
  }
  .nav-links a.nav-cta {
    background: var(--text);
    color: #fff;
    padding: 7px 18px;
  }
  .nav-links a.nav-cta:hover {
    background: #333;
    color: #fff;
  }
  .nav-links a.nav-cta.active {
    background: var(--text);
    color: #fff;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    width: 28px;
    height: 22px;
    justify-content: center;
  }
  .nav-toggle span {
    display: block;
    height: 1.5px;
    background: var(--text);
    border-radius: 1px;
    transition: transform 0.3s ease, opacity 0.3s ease;
    transform-origin: center;
  }
  .nav-toggle span:first-child { width: 22px; }
  .nav-toggle span:last-child { width: 14px; }
  .nav-toggle.open span:first-child {
    transform: translateY(3.25px) rotate(45deg);
    width: 20px;
  }
  .nav-toggle.open span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
    width: 20px;
  }

  @media (max-width: 680px) {
    .nav-unis { display: none; }
    nav { height: 60px; }
    .nav-section-badge { display: none; }
    .nav-links {
      display: none;
      position: fixed;
      top: 60px; left: 0; right: 0;
      background: rgba(255,255,255,0.98);
      backdrop-filter: blur(30px);
      -webkit-backdrop-filter: blur(30px);
      flex-direction: column;
      align-items: stretch;
      padding: 12px 6vw 20px;
      gap: 0;
      border-bottom: 1px solid var(--border);
    }
    .nav-links.open { display: flex; }
    .nav-links a { padding: 14px 0; font-size: 17px; border-radius: 0; }
    .nav-links a.nav-cta {
      margin-top: 12px;
      padding: 12px 20px;
      border-radius: var(--radius-pill);
      text-align: center;
    }
    .nav-toggle { display: flex; }
    .nav-brand-text { font-size: 14px; }
  }
</style>
