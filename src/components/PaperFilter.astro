---
import type { Paper } from '../components/PaperFilter';

interface Props {
  papers: Paper[];
  filterTags: string[];
}

const { papers, filterTags } = Astro.props;

function ifClass(imp: number) {
  if (imp >= 7) return 'if-gold';
  if (imp >= 5) return 'if-blue';
  return '';
}

function highlightAuthor(authors: string) {
  return authors.replace(/(Y\. Yan)/g, '<mark>$1</mark>');
}

const years = [...new Set(papers.map(p => p.year))].sort((a, b) => b - a);
---

<div id="paper-filter-root">
  <div class="filter-bar">
    {filterTags.map(tag => (
      <button class="filter-chip" data-tag={tag}>{tag}</button>
    ))}
  </div>

  <div class="paper-list">
    {years.map(year => (
      <div data-year={year}>
        <div class="year-divider"><span>{year}</span></div>
        {papers.filter(p => p.year === year).map(paper => (
          <div class="paper-row" data-num={paper.num} data-tags={paper.tags.join(',')}>
            <div class="pr-num">{paper.num}</div>
            <div class="pr-body">
              <div class="pr-title">{paper.title}</div>
              <div class="pr-authors" set:html={highlightAuthor(paper.authors)} />
              <div class="pr-tags">
                <span class="pr-tag venue">{paper.journal}</span>
                {paper.impactFactor && (
                  <span class={`pr-tag if ${ifClass(paper.impactFactor)}`}>IF {paper.impactFactor}</span>
                )}
                {paper.quartile && (
                  <span class={`pr-tag rank${paper.isTop ? ' top' : ''}`}>
                    {paper.quartile}{paper.isTop ? ' Top' : ''}
                  </span>
                )}
                {paper.tags
                  .filter(t => !['一区', '二区', '会议'].includes(t))
                  .map(t => <span class="pr-tag topic">{t}</span>)}
              </div>
            </div>
            <div class="pr-year">{paper.year}</div>
          </div>
        ))}
      </div>
    ))}
    <div class="no-results" style="display:none">该分类下暂无论文</div>
  </div>
</div>

<script>
  const chips = document.querySelectorAll('#paper-filter-root .filter-chip');
  const groups = document.querySelectorAll('#paper-filter-root [data-year]');
  const noResults = document.querySelector('#paper-filter-root .no-results')!;
  let active = '全部';

  chips[0]?.classList.add('active');

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      const tag = chip.getAttribute('data-tag')!;
      active = tag;
      chips.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');

      let any = false;
      groups.forEach(group => {
        const rows = group.querySelectorAll<HTMLElement>('.paper-row');
        let groupHas = false;
        rows.forEach(row => {
          const tags = row.getAttribute('data-tags')!.split(',');
          const show = tag === '全部' || tags.includes(tag);
          row.style.display = show ? '' : 'none';
          if (show) groupHas = true;
        });
        (group as HTMLElement).style.display = groupHas ? '' : 'none';
        if (groupHas) any = true;
      });
      (noResults as HTMLElement).style.display = any ? 'none' : '';
    });
  });
</script>

<style>
  #paper-filter-root .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 48px;
  }
  #paper-filter-root .filter-chip {
    padding: 6px 16px;
    font-size: 12px;
    font-weight: 500;
    border-radius: 100px;
    border: 1.5px solid rgba(0,0,0,0.1);
    background: transparent;
    color: #888;
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
    font-family: inherit;
    letter-spacing: 0.2px;
    line-height: 1.5;
  }
  #paper-filter-root .filter-chip:hover {
    border-color: rgba(0,0,0,0.25);
    color: #333;
    background: #f5f5f5;
  }
  #paper-filter-root .filter-chip.active {
    background: rgba(0,87,255,0.07);
    border-color: rgba(0,87,255,0.25);
    color: #0057FF;
  }
  #paper-filter-root .paper-list {
    display: flex;
    flex-direction: column;
  }
  #paper-filter-root .year-divider {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 24px 16px 10px;
    font-size: 11px;
    letter-spacing: 3px;
    color: #aaa;
    font-family: var(--font-mono);
  }
  #paper-filter-root .year-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(0,0,0,0.08);
  }
  #paper-filter-root .paper-row {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    gap: 20px;
    align-items: start;
    padding: 20px 16px;
    border-radius: 8px;
    transition: background 0.15s;
  }
  #paper-filter-root .paper-row:hover {
    background: #f7f7f7;
  }
  #paper-filter-root .pr-num {
    font-size: 11px;
    color: #bbb;
    font-family: var(--font-mono);
    padding-top: 3px;
    font-variant-numeric: tabular-nums;
  }
  #paper-filter-root .pr-title {
    font-size: 15px;
    font-weight: 500;
    line-height: 1.55;
    margin-bottom: 6px;
    color: #0A0A0A;
    letter-spacing: -0.01em;
  }
  #paper-filter-root .pr-authors {
    font-size: 12px;
    color: #888;
    margin-bottom: 10px;
    line-height: 1.6;
  }
  #paper-filter-root .pr-authors mark {
    background: none;
    color: #0057FF;
  }
  #paper-filter-root .pr-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  #paper-filter-root .pr-tag {
    display: inline-block;
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 4px;
    font-family: var(--font-mono);
  }
  #paper-filter-root .pr-tag.venue {
    background: rgba(0,87,255,0.06);
    color: #0057FF;
    border: 1px solid rgba(0,87,255,0.12);
  }
  #paper-filter-root .pr-tag.if {
    background: #f0f0f0;
    color: #888;
  }
  #paper-filter-root .pr-tag.if.if-gold {
    background: rgba(240,185,11,0.1);
    color: #b8860b;
  }
  #paper-filter-root .pr-tag.if.if-blue {
    background: rgba(0,87,255,0.08);
    color: #0057FF;
  }
  #paper-filter-root .pr-tag.rank {
    background: #f0f0f0;
    color: #888;
  }
  #paper-filter-root .pr-tag.rank.top {
    background: rgba(40,180,100,0.07);
    color: #1a9a56;
  }
  #paper-filter-root .pr-tag.topic {
    background: transparent;
    color: #aaa;
    border: 1px solid rgba(0,0,0,0.08);
  }
  #paper-filter-root .pr-year {
    font-size: 11px;
    color: #5B8DEE;
    font-family: var(--font-mono);
    padding-top: 3px;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  #paper-filter-root .no-results {
    color: #aaa;
    font-size: 14px;
    padding: 40px 16px;
    text-align: center;
  }
  @media (max-width: 560px) {
    #paper-filter-root .paper-row { grid-template-columns: 1fr; gap: 8px; }
    #paper-filter-root .pr-num, #paper-filter-root .pr-year { display: none; }
  }
</style>
