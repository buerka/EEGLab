---
<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <svg width="18" height="18" viewBox="0 0 22 22" fill="none">
        <rect x="1" y="10" width="20" height="1.4" rx="0.7" fill="currentColor" opacity="0.3"/>
        <path d="M1 10 Q4 4 8 10 Q11 16 14 10 Q18 4 21 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/>
      </svg>
      <span>金牛湖脑机实验室</span>
    </div>
    <nav class="footer-nav">
      <a href="/research">研究方向</a>
      <a href="/team">团队成员</a>
      <a href="/achievements">科研成果</a>
      <a href="/contact">联系我们</a>
    </nav>
    <p class="footer-copy">&copy; 2025 Brain-Computer Interface Lab · NUIST</p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 48px 6vw;
    background: var(--bg);
  }
  .footer-inner {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }
  .footer-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-3);
    font-size: 13px;
    font-weight: 600;
  }
  .footer-brand svg { color: var(--text-3); }
  .footer-nav {
    display: flex;
    gap: 24px;
  }
  .footer-nav a {
    font-size: 13px;
    color: var(--text-3);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-nav a:hover { color: var(--text); }
  .footer-copy {
    font-size: 12px;
    color: var(--text-3);
    font-family: var(--font-mono);
    text-align: right;
  }
  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 20px;
    }
    .footer-brand { justify-content: center; }
    .footer-nav { justify-content: center; flex-wrap: wrap; gap: 16px; }
    .footer-copy { text-align: center; }
  }
</style>
