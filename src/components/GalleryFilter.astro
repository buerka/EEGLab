---
interface GalleryItem {
  src: string;
  label: string;
  tag: string;
}

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;

const allTags = ['全部', ...Array.from(new Set(items.map(i => i.tag)))];
---

<div id="gallery-filter-root">
  <div class="gf-filter-bar">
    {allTags.map(tag => (
      <button class="gf-chip" data-tag={tag}>{tag}</button>
    ))}
  </div>

  <div class="gf-grid">
    {items.map(item => (
      <div class="gf-item" data-tag={item.tag}>
        <img src={item.src} alt={item.label} class="gf-img" loading="lazy" />
        <div class="gf-caption">
          <span class="gf-tag">{item.tag}</span>
          <span class="gf-label">{item.label}</span>
        </div>
      </div>
    ))}
  </div>

  <div class="gf-no-results" style="display:none">该分类下暂无内容</div>
</div>

<script>
  const root = document.getElementById('gallery-filter-root')!;
  const chips = root.querySelectorAll<HTMLButtonElement>('.gf-chip');
  const items = root.querySelectorAll<HTMLElement>('.gf-item');
  const noResults = root.querySelector<HTMLElement>('.gf-no-results')!;

  chips[0]?.classList.add('active');

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      const tag = chip.getAttribute('data-tag')!;
      chips.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');

      let any = false;
      items.forEach(item => {
        const show = tag === '全部' || item.getAttribute('data-tag') === tag;
        item.style.display = show ? '' : 'none';
        if (show) any = true;
      });
      noResults.style.display = any ? 'none' : '';
    });
  });
</script>

<style>
  #gallery-filter-root .gf-filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 32px;
  }
  #gallery-filter-root .gf-chip {
    padding: 6px 16px;
    font-size: 12px;
    font-weight: 500;
    border-radius: 100px;
    border: 1.5px solid rgba(0,0,0,0.1);
    background: transparent;
    color: #888;
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
    font-family: inherit;
    letter-spacing: 0.2px;
    line-height: 1.5;
  }
  #gallery-filter-root .gf-chip:hover {
    border-color: rgba(0,0,0,0.25);
    color: #333;
    background: #f5f5f5;
  }
  #gallery-filter-root .gf-chip.active {
    background: rgba(0,87,255,0.07);
    border-color: rgba(0,87,255,0.25);
    color: #0057FF;
  }
  #gallery-filter-root .gf-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  #gallery-filter-root .gf-item {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-surface);
    transition: border-color 0.25s, box-shadow 0.25s;
    display: flex;
    flex-direction: column;
  }
  #gallery-filter-root .gf-item:hover {
    border-color: var(--border-md);
    box-shadow: 0 4px 20px rgba(0,0,0,0.07);
  }
  #gallery-filter-root .gf-img {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    object-position: top;
    display: block;
  }
  #gallery-filter-root .gf-caption {
    padding: 12px 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    border-top: 1px solid var(--border);
    background: var(--bg);
  }
  #gallery-filter-root .gf-tag {
    font-size: 10px;
    font-family: var(--font-mono);
    padding: 2px 7px;
    border-radius: 100px;
    background: rgba(0,87,255,0.07);
    color: #0057FF;
    border: 1px solid rgba(0,87,255,0.12);
    flex-shrink: 0;
    white-space: nowrap;
  }
  #gallery-filter-root .gf-label {
    font-size: 12px;
    color: #666;
    line-height: 1.4;
  }
  #gallery-filter-root .gf-no-results {
    color: #aaa;
    font-size: 14px;
    padding: 40px 16px;
    text-align: center;
  }
  @media (max-width: 900px) {
    #gallery-filter-root .gf-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    #gallery-filter-root .gf-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
