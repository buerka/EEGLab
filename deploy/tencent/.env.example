# 腾讯云国内站：Makers 与 SCF 共享桶和生产前缀。
COS_REGION=ap-shanghai
COS_BUCKET=your-private-bucket-1250000000
COS_PREFIX=eeglab/production

# Makers 中配置专用 CAM 子账号凭据；SCF 推荐使用执行角色注入临时凭据。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SESSION_TOKEN=

# 至少 32 个随机字符；两处保持一致。不要将这些变量加 PUBLIC_ 前缀。
PAPERS_SYNC_TOKEN=
ANALYTICS_HMAC_SECRET=
PAPERS_ALLOWED_ORIGINS=https://your-lab-domain.edu.cn

# 两个来源的凭据只用于服务端；SCF 必填对应已启用来源的密钥。
OPENALEX_API_KEY=
SERPAPI_API_KEY=
PAPERS_SYNC_MINIMUM_RATIO=0.8
SCHOLAR_MATCH_THRESHOLD=0.94
SCHOLAR_MINIMUM_RATIO=0.5
ANALYTICS_INITIAL_TOTAL=0
ANALYTICS_DEDUPE_SECONDS=30
TZ=Asia/Shanghai

# 仅 Makers 的前端构建读取这些公开变量。
PUBLIC_PAPERS_API_URL=/api
PUBLIC_ICP_NUMBER=
