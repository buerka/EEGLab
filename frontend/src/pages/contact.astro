---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="联系我们 · 金牛湖脑机实验室" description="汇聚跨学科智慧，诚邀各界英才共筑脑机未来">
  <Nav active="home" />

  <div class="page-header">
    <div class="container">
      <a href="/" class="back-link">
        <svg viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        返回主页
      </a>
      <div class="section-label">CONTACT</div>
      <h1 class="ph-title">联系我们</h1>
      <p class="ph-desc">汇聚跨学科智慧，诚邀各界英才共筑脑机未来</p>
    </div>
  </div>

  <div class="contact-body">
    <div class="container">
      <div class="contact-grid">
        <!-- Info -->
        <div class="contact-info fade-up">
          <div class="info-group">
            <div class="info-label">实验室邮箱</div>
            <a href="mailto:ying.yan@nuist.edu.cn" class="info-value link">ying.yan@nuist.edu.cn</a>
          </div>
          <div class="info-group">
            <div class="info-label">联系电话</div>
            <div class="info-value">+86 152-0517-6357</div>
          </div>
          <div class="info-group">
            <div class="info-label">办公地址</div>
            <div class="info-value">南京信息工程大学<br/>金牛湖产教融合园区</div>
          </div>
          <div class="info-group">
            <div class="info-label">导师主页</div>
            <a href="https://faculty.nuist.edu.cn/yanying/zh_CN/index.htm" target="_blank" rel="noopener" class="arrow-link" style="font-size:15px">
              访问导师主页
              <span class="arrow-icon">
                <svg class="arrow-out" viewBox="0 0 18 18"><path d="M2 16L16 2M16 2H6M16 2V12"/></svg>
                <svg class="arrow-in" viewBox="0 0 18 18"><path d="M2 16L16 2M16 2H6M16 2V12"/></svg>
              </span>
            </a>
          </div>
        </div>

        <!-- Join info -->
        <div class="contact-join fade-up delay-2">
          <h2 class="join-title">加入我们</h2>
          <p class="join-desc">
            课题组长期招收对脑机接口、EEG 信号分析、神经工程、嵌入式系统、机器人控制等方向感兴趣的研究生（学硕/专硕）与本科生。课题组依托南京信息工程大学自动化学院与金牛湖产教融合园区，拥有完善的实验平台与充足的科研经费，与多所国际知名高校保持密切合作关系。
          </p>
          <div class="join-requirements">
            <h3 class="jr-title">申请要求</h3>
            <ul class="jr-list">
              <li>自动化、电气工程、计算机科学、生物医学工程等相关专业背景</li>
              <li>具备扎实的数学基础与编程能力（Python / MATLAB）</li>
              <li>对神经工程与脑机接口领域有浓厚兴趣</li>
              <li>具有良好的英语阅读与写作能力</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); } });
  }, { threshold: 0.08 });
  document.querySelectorAll('.fade-up').forEach(el => io.observe(el));
</script>

<style>
  .page-header {
    padding: 140px 0 72px;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border);
  }
  .back-link {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 14px; color: var(--text-3); text-decoration: none;
    margin-bottom: 32px; transition: color 0.15s;
  }
  .back-link:hover { color: var(--text-2); }
  .back-link svg { width: 16px; height: 16px; }

  .ph-title {
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 700; letter-spacing: -0.03em;
    line-height: 1.05; margin-bottom: 16px; margin-top: 12px;
  }
  .ph-desc {
    font-size: 17px; color: var(--text-2); max-width: 520px;
  }

  .contact-body { padding: 80px 0 120px; }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }

  /* Info */
  .info-group {
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 28px;
  }
  .info-label {
    font-size: 10px; font-family: var(--font-mono);
    letter-spacing: 3px; color: var(--text-3);
    text-transform: uppercase; margin-bottom: 10px;
  }
  .info-value {
    font-size: 17px; color: var(--text-2); line-height: 1.6;
  }
  .info-value.link {
    color: var(--accent); text-decoration: none;
    font-family: var(--font-mono); font-size: 15px;
    transition: opacity 0.2s;
  }
  .info-value.link:hover { opacity: 0.7; }

  /* Join */
  .join-title {
    font-size: 28px; font-weight: 700;
    letter-spacing: -0.02em; margin-bottom: 20px;
  }
  .join-desc {
    font-size: 16px; color: var(--text-2);
    line-height: 1.85; margin-bottom: 40px;
  }
  .join-requirements {
    padding: 32px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }
  .jr-title {
    font-size: 14px; font-weight: 600;
    margin-bottom: 16px; letter-spacing: -0.01em;
  }
  .jr-list {
    list-style: none; display: flex; flex-direction: column; gap: 14px;
  }
  .jr-list li {
    font-size: 15px; color: var(--text-2);
    line-height: 1.7; padding-left: 18px;
    position: relative;
  }
  .jr-list li::before {
    content: '';
    position: absolute; left: 0; top: 10px;
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--accent); opacity: 0.6;
  }

  @media (max-width: 768px) {
    .contact-grid { grid-template-columns: 1fr; gap: 48px; }
  }
</style>
