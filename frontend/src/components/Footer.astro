---
---
<footer>
  <div class="footer-row">

    <div class="footer-left">
      <div class="footer-brand">
        <svg width="18" height="18" viewBox="0 0 22 22" fill="none">
          <rect x="1" y="10" width="20" height="1.4" rx="0.7" fill="currentColor" opacity="0.3"/>
          <path d="M1 10 Q4 4 8 10 Q11 16 14 10 Q18 4 21 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/>
        </svg>
        <span>金牛湖脑机实验室</span>
      </div>
      <p class="footer-copy"> &copy; 2025 Brain-Computer Interface Lab · NUIST</p>
    </div>

    <nav class="footer-nav">
      <a href="/research">研究方向</a>
      <a href="/team">团队成员</a>
      <a href="/achievements">科研成果</a>
      <a href="/contact">联系我们</a>
    </nav>

    <div class="footer-unis">
      <a href="https://www.nuist.edu.cn" target="_blank" rel="noopener noreferrer">
        <img src="/images/nuist-logo.png" alt="南京信息工程大学" class="footer-uni-logo nuist" />
      </a>
      <a href="https://www.ahjzu.edu.cn" target="_blank" rel="noopener noreferrer">
        <img src="/images/ahjzu-logo.png" alt="安徽建筑大学" class="footer-uni-logo ahjzu" />
      </a>
    </div>

  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 32px 6vw;
    background: var(--bg);
  }
  .footer-row {
    max-width: 1320px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
  .footer-left {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex-shrink: 0;
  }
  .footer-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-3);
    font-size: 13px;
    font-weight: 600;
  }
  .footer-brand svg { color: var(--text-3); }
  .footer-copy {
    font-size: 11px;
    color: var(--text-3);
    font-family: var(--font-mono);
    letter-spacing: 0.3px;
  }
  .footer-nav {
    display: flex;
    gap: 28px;
    justify-content: center;
    flex: 1;
  }
  .footer-nav a {
    font-size: 13px;
    color: var(--text-3);
    text-decoration: none;
    transition: color 0.2s;
    white-space: nowrap;
  }
  .footer-nav a:hover { color: var(--text); }
  .footer-unis {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-shrink: 0;
  }
  .footer-uni-logo {
    height: 52px;
    width: auto;
    object-fit: contain;
  }
  .footer-uni-logo.nuist { height: 66px; }
  .footer-uni-logo.ahjzu { height: 52px; }

  @media (max-width: 768px) {
    .footer-row {
      flex-direction: column;
      align-items: center;
      gap: 20px;
      text-align: center;
    }
    .footer-left { align-items: center; }
    .footer-nav { flex-wrap: wrap; justify-content: center; gap: 16px; }
  }
</style>
