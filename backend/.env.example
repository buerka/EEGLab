OPENALEX_API_KEY=
SERPAPI_API_KEY=
PAPERS_SYNC_TOKEN=replace-with-a-long-random-token
# 本地开发使用相对路径；Docker Compose 会覆盖为 /data/papers.db。
PAPERS_DATABASE_PATH=./data/papers.db
PAPERS_ALLOWED_ORIGINS=https://example.edu.cn,http://localhost:4321
PAPERS_CACHE_CONTROL=public, max-age=0, s-maxage=60, stale-while-revalidate=300
PAPERS_SYNC_INTERVAL_SECONDS=86400
PAPERS_SYNC_MINIMUM_RATIO=0.8
SCHOLAR_MATCH_THRESHOLD=0.94
SCHOLAR_MINIMUM_RATIO=0.5
